+bool DecompressDataZSTD(std::istream& source, std::ostream& destination) {
+    std::unique_ptr<ZSTD_DCtx, decltype(&ZSTD_freeDCtx)> context{ZSTD_createDCtx(), ZSTD_freeDCtx};
+    if (!context || ZSTD_isError(ZSTD_initDStream(context.get()))) {
+        LOG_ERROR(Common, "Could not initialize streaming ZSTD decompression");
+        return false;
+    }
+
+    std::vector<u8> input_buffer(ZSTD_DStreamInSize());
+    std::vector<u8> output_buffer(ZSTD_DStreamOutSize());
+    bool frame_complete = false;
+    while (!frame_complete) {
+        source.read(reinterpret_cast<char*>(input_buffer.data()), input_buffer.size());
+        const std::size_t bytes_read = static_cast<std::size_t>(source.gcount());
+        ZSTD_inBuffer in{input_buffer.data(), bytes_read, 0};
+        while (in.pos < in.size) {
+            ZSTD_outBuffer out{output_buffer.data(), output_buffer.size(), 0};
+            const std::size_t remaining = ZSTD_decompressStream(context.get(), &out, &in);
+            if (ZSTD_isError(remaining)) {
+                LOG_ERROR(Common, "Streaming ZSTD decompression failed: {}",
+                          ZSTD_getErrorName(remaining));
+                return false;
+            }
+            destination.write(reinterpret_cast<const char*>(output_buffer.data()), out.pos);
+            if (!destination) {
+                LOG_ERROR(Common, "Could not write streaming ZSTD output");
+                return false;
+            }
+            if (remaining == 0) {
+                frame_complete = true;
+                break;
+            }
+        }
+        if (!frame_complete && (bytes_read == 0 || source.eof())) {
+            ZSTD_outBuffer out{output_buffer.data(), output_buffer.size(), 0};
+            const std::size_t remaining = ZSTD_decompressStream(context.get(), &out, &in);
+            if (ZSTD_isError(remaining)) {
+                LOG_ERROR(Common, "Streaming ZSTD decompression failed: {}",
+                          ZSTD_getErrorName(remaining));
+                return false;
+            }
+            destination.write(reinterpret_cast<const char*>(output_buffer.data()), out.pos);
+            if (!destination || remaining != 0) {
+                LOG_ERROR(Common, "Incomplete streaming ZSTD input");
+                return false;
+            }
+            frame_complete = true;
+        }
+    }
+    return true;
+}
