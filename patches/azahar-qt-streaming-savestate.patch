+bool CompressDataZSTD(std::istream& source, std::ostream& destination, u64 source_size) {
+    std::unique_ptr<ZSTD_CCtx, decltype(&ZSTD_freeCCtx)> context{ZSTD_createCCtx(), ZSTD_freeCCtx};
+    if (!context || ZSTD_isError(ZSTD_CCtx_setParameter(context.get(), ZSTD_c_compressionLevel,
+                                                          ZSTD_CLEVEL_DEFAULT)) ||
+        ZSTD_isError(ZSTD_CCtx_setPledgedSrcSize(context.get(), source_size))) {
+        LOG_ERROR(Common, "Could not initialize streaming ZSTD compression");
+        return false;
+    }
+
+    std::vector<u8> input_buffer(ZSTD_CStreamInSize());
+    std::vector<u8> output_buffer(ZSTD_CStreamOutSize());
+    u64 total_read = 0;
+    for (;;) {
+        const std::size_t amount = static_cast<std::size_t>(
+            std::min<u64>(input_buffer.size(), source_size - total_read));
+        source.read(reinterpret_cast<char*>(input_buffer.data()), amount);
+        if (source.gcount() != static_cast<std::streamsize>(amount)) {
+            LOG_ERROR(Common, "Streaming ZSTD source ended after {} of {} bytes", total_read,
+                      source_size);
+            return false;
+        }
+        total_read += amount;
+        ZSTD_inBuffer in{input_buffer.data(), amount, 0};
+        const ZSTD_EndDirective directive = total_read == source_size ? ZSTD_e_end : ZSTD_e_continue;
+        std::size_t remaining;
+        do {
+            ZSTD_outBuffer out{output_buffer.data(), output_buffer.size(), 0};
+            remaining = ZSTD_compressStream2(context.get(), &out, &in, directive);
+            if (ZSTD_isError(remaining)) {
+                LOG_ERROR(Common, "Streaming ZSTD compression failed: {}",
+                          ZSTD_getErrorName(remaining));
+                return false;
+            }
+            destination.write(reinterpret_cast<const char*>(output_buffer.data()), out.pos);
+            if (!destination) {
+                LOG_ERROR(Common, "Could not write streaming ZSTD output");
+                return false;
+            }
+        } while (in.pos < in.size || (directive == ZSTD_e_end && remaining != 0));
+        if (directive == ZSTD_e_end) {
+            return true;
+        }
+    }
+}
