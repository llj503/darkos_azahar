+// Reads the handheld gamepad straight from the kernel evdev node. The menu must keep
+// working even when SDL's joystick polling stalls, and evdev always delivers events.
+class EvdevGamepad {
+public:
+    static constexpr size_t kNumButtons = 12;
+
+    EvdevGamepad() {
+        for (auto& button : m_buttons) {
+            button.store(false, std::memory_order_relaxed);
+        }
+        for (auto& count : m_press_count) {
+            count.store(0, std::memory_order_relaxed);
+        }
+        OpenDevice();
+        RefreshButtons();
+        m_running.store(true, std::memory_order_relaxed);
+        m_thread = std::thread([this] { RefreshLoop(); });
+    }
+
+    ~EvdevGamepad() {
+        m_running.store(false, std::memory_order_relaxed);
+        if (m_thread.joinable()) {
+            m_thread.join();
+        }
+        if (m_fd >= 0) {
+            ::close(m_fd);
+        }
+    }
+
+    bool GetButton(size_t index) const {
+        return index < kNumButtons && m_buttons[index].load(std::memory_order_relaxed);
+    }
+
+    uint32_t GetPressCount(size_t index) const {
+        return index < kNumButtons ? m_press_count[index].load(std::memory_order_relaxed) : 0;
+    }
+
+    std::tuple<float, float> GetStick() const {
+        const float x = m_abs_x.load(std::memory_order_relaxed) / 32767.0f;
+        const float y = -m_abs_y.load(std::memory_order_relaxed) / 32767.0f;
+        const float r2 = x * x + y * y;
+        if (r2 > 1.0f) {
+            const float r = std::sqrt(r2);
+            return {x / r, y / r};
+        }
+        return {x, y};
+    }
+
+private:
+    void OpenDevice() {
+        QDir input_dir(QStringLiteral("/sys/class/input"));
+        const auto entries = input_dir.entryList(QStringList{QStringLiteral("event*")}, QDir::Dirs);
+        for (const QString& entry : entries) {
+            QFile name_file(QStringLiteral("/sys/class/input/%1/device/name").arg(entry));
+            if (!name_file.open(QIODevice::ReadOnly)) {
+                continue;
+            }
+            const QString name = QString::fromUtf8(name_file.readAll()).trimmed();
+            name_file.close();
+            if (name != QStringLiteral("rk3562-joystick")) {
+                continue;
+            }
+            const QString path = QStringLiteral("/dev/input/%1").arg(entry);
+            m_fd = ::open(path.toLocal8Bit().constData(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+            if (m_fd >= 0) {
+                LOG_INFO(Frontend, "OSD evdev gamepad opened {}", path.toStdString());
+                return;
+            }
+        }
+        m_fd = -1;
+    }
+
+    static constexpr std::array<int, kNumButtons> kCodes{
+        BTN_SELECT, BTN_DPAD_UP, BTN_DPAD_DOWN, BTN_DPAD_LEFT, BTN_DPAD_RIGHT,
+        BTN_EAST, BTN_SOUTH, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR, BTN_START};
+
+    bool RefreshButtons() {
+        unsigned long bits[(KEY_CNT + 8 * sizeof(unsigned long) - 1) /
+                           (8 * sizeof(unsigned long))]{};
+        if (m_fd < 0 || ::ioctl(m_fd, EVIOCGKEY(sizeof(bits)), bits) < 0) {
+            return false;
+        }
+        constexpr size_t bits_per_word = 8 * sizeof(unsigned long);
+        for (size_t i = 0; i < kNumButtons; ++i) {
+            const size_t bit = static_cast<size_t>(kCodes[i]);
+            m_buttons[i].store((bits[bit / bits_per_word] >> (bit % bits_per_word)) & 1UL,
+                               std::memory_order_relaxed);
+        }
+        input_absinfo abs_x{};
+        input_absinfo abs_y{};
+        if (::ioctl(m_fd, EVIOCGABS(ABS_X), &abs_x) == 0) {
+            m_abs_x.store(abs_x.value, std::memory_order_relaxed);
+        }
+        if (::ioctl(m_fd, EVIOCGABS(ABS_Y), &abs_y) == 0) {
+            m_abs_y.store(abs_y.value, std::memory_order_relaxed);
+        }
+        return true;
+    }
+
+    bool HandleEvent(const input_event& event) {
+        if (event.type == EV_KEY) {
+            for (size_t i = 0; i < kNumButtons; ++i) {
+                if (event.code == kCodes[i]) {
+                    if (event.value == 1) {
+                        m_press_count[i].fetch_add(1, std::memory_order_relaxed);
+                    }
+                    m_buttons[i].store(event.value != 0, std::memory_order_relaxed);
+                    break;
+                }
+            }
+        } else if (event.type == EV_ABS) {
+            if (event.code == ABS_X) {
+                m_abs_x.store(event.value, std::memory_order_relaxed);
+            } else if (event.code == ABS_Y) {
+                m_abs_y.store(event.value, std::memory_order_relaxed);
+            }
+        } else if (event.type == EV_SYN && event.code == SYN_DROPPED) {
+            return true;
+        }
+        return false;
+    }
+
+    void RefreshLoop() {
+        using namespace std::chrono_literals;
+        std::array<input_event, 32> events{};
+        while (m_running.load(std::memory_order_relaxed)) {
+            if (m_fd < 0) {
+                OpenDevice();
+                if (m_fd < 0) {
+                    std::this_thread::sleep_for(200ms);
+                    continue;
+                }
+                if (!RefreshButtons()) {
+                    ::close(m_fd);
+                    m_fd = -1;
+                    std::this_thread::sleep_for(200ms);
+                    continue;
+                }
+            }
+            bool resync = false;
+            for (;;) {
+                const ssize_t bytes = ::read(m_fd, events.data(), sizeof(events));
+                if (bytes < 0) {
+                    if (errno == EINTR) {
+                        continue;
+                    }
+                    if (errno == ENODEV || errno == EBADF) {
+                        ::close(m_fd);
+                        m_fd = -1;
+                    }
+                    break;
+                }
+                if (bytes == 0) {
+                    break;
+                }
+                const size_t count = static_cast<size_t>(bytes) / sizeof(input_event);
+                for (size_t i = 0; i < count; ++i) {
+                    resync = HandleEvent(events[i]) || resync;
+                }
+                if (m_fd < 0) {
+                    break;
+                }
+            }
+            if (m_fd < 0) {
+                std::this_thread::sleep_for(200ms);
+                continue;
+            }
+            if (resync && !RefreshButtons()) {
+                if (errno == ENODEV || errno == EBADF) {
+                    ::close(m_fd);
+                    m_fd = -1;
+                }
+                std::this_thread::sleep_for(200ms);
+                continue;
+            }
+            std::this_thread::sleep_for(8ms);
+        }
+    }
+
+    std::atomic<bool> m_running{false};
+    std::thread m_thread;
+    int m_fd = -1;
+    std::array<std::atomic<bool>, kNumButtons> m_buttons{};
+    std::array<std::atomic<uint32_t>, kNumButtons> m_press_count{};
+    std::atomic<int> m_abs_x{0};
+    std::atomic<int> m_abs_y{0};
+};
