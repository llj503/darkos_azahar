+template <typename Type, bool ranged>
+void OsdOverlay::AddChoice(Page& page, const QString& label, const QString& hint,
+                           Settings::SwitchableSetting<Type, ranged>& setting,
+                           const std::vector<std::pair<QString, Type>>& choices) {
+    QStringList labels;
+    std::vector<Type> values;
+    labels.reserve(static_cast<qsizetype>(choices.size()));
+    values.reserve(choices.size());
+    int selected = 0;
+    double best_distance = std::numeric_limits<double>::infinity();
+    for (size_t i = 0; i < choices.size(); ++i) {
+        labels.append(choices[i].first);
+        values.push_back(choices[i].second);
+        const double distance =
+            std::abs(static_cast<double>(setting.GetValue()) - static_cast<double>(choices[i].second));
+        if (distance < best_distance) {
+            best_distance = distance;
+            selected = static_cast<int>(i);
+        }
+    }
+    AddChoice(page, label, hint, labels, selected, [this, &setting, values](int index) {
+        if (index < 0 || static_cast<size_t>(index) >= values.size()) {
+            return;
+        }
+        Assign(setting, values[index]);
+        emit settingsChanged();
+        ShowMessage(QStringLiteral("设置已保存"));
+    });
+}
+
+template <typename Type, bool ranged>
+void OsdOverlay::AddToggle(Page& page, const QString& label, const QString& hint,
+                           Settings::SwitchableSetting<Type, ranged>& setting) {
+    AddChoice(page, label, hint, setting,
+              {{QStringLiteral("关闭"), Type{0}}, {QStringLiteral("开启"), Type{1}}});
+}
+
+template <typename Type, bool ranged>
+void OsdOverlay::Assign(Settings::SwitchableSetting<Type, ranged>& setting, const Type& value) {
+    setting.SetGlobal(!m_per_game_active);
+    setting.SetValue(value);
+    LOG_INFO(Frontend, "OSD setting {}={} per_game={}", setting.GetLabel(), value,
+             m_per_game_active);
+}
+
+template <typename Type, bool ranged>
+void OsdOverlay::Snapshot(Settings::SwitchableSetting<Type, ranged>& setting) {
+    const Type value = setting.GetValue();
+    setting.SetGlobal(false);
+    setting.SetValue(value);
+}
+
+void OsdOverlay::CreateInputDevices() {
+    m_gamepad = std::make_shared<EvdevGamepad>();
+    for (size_t i = 0; i < m_buttons.size(); ++i) {
+        m_buttons[i] = std::make_unique<EvdevButtonDevice>(m_gamepad, i);
+    }
+    m_stick = std::make_unique<EvdevAnalogDevice>(m_gamepad);
+}
+
+void OsdOverlay::PollInput() {
+    const qint64 now = NowMs();
+    if (m_shutdown || !parentWidget() || !parentWidget()->isVisible()) {
+        return;
+    }
+
+    for (size_t i = 0; i < m_buttons.size(); ++i) {
+        const bool down = m_buttons[i] && m_buttons[i]->GetStatus();
+        const auto button = static_cast<Button>(i);
+        if (button == Button::Select) {
+            HandleButton(button, down, m_button_down[i], now);
+        } else {
+            const uint32_t count = m_gamepad ? m_gamepad->GetPressCount(i) : 0;
+            const uint32_t pending = count - m_last_press_count[i];
+            m_last_press_count[i] = count;
+            const uint32_t replay = std::min<uint32_t>(pending, 8);
+            for (uint32_t n = 0; n < replay; ++n) {
+                HandleButton(button, true, false, now);
+                if (m_shutdown) {
+                    return;
+                }
+            }
+            if (replay == 0 && down && !m_button_down[i]) {
+                HandleButton(button, true, false, now);
+            }
+        }
+        m_button_down[i] = down;
+        if (m_shutdown) {
+            return;
+        }
+    }
+
+    if (m_stick) {
+        const auto [x, y] = m_stick->GetStatus();
+        const float old_x = m_stick_x;
+        const float old_y = m_stick_y;
+        m_stick_x = x;
+        m_stick_y = y;
+        if (m_open && !m_resume_pending) {
+            if (m_layout_editor) {
+                HandleLayoutStick(x, y);
+            } else {
+                if (x < -0.55f && old_x >= -0.35f) {
+                    MoveSelection(-1);
+                } else if (x > 0.55f && old_x <= 0.35f) {
+                    MoveSelection(1);
+                }
+                if (y > 0.55f && old_y <= 0.35f) {
+                    MoveSelection(-1);
+                } else if (y < -0.55f && old_y >= -0.35f) {
+                    MoveSelection(1);
+                }
+            }
+        }
+    }
+
+    if (m_resume_pending && !m_button_down[static_cast<size_t>(m_resume_button)]) {
+        FinishResume();
+    }
+}
+
+void OsdOverlay::HandleButton(Button button, bool down, bool was_down, qint64 now) {
+    const size_t index = static_cast<size_t>(button);
+    if (button == Button::Select) {
+        if (down && !was_down) {
+            m_select_pressed_at = now;
+            m_select_long_fired = false;
+        }
+        if (down && !m_select_long_fired && now - m_select_pressed_at >= kLongPressMs) {
+            m_select_long_fired = true;
+            if (m_layout_editor) {
+                m_layout_editor = false;
+                emit customLayoutChanged(true);
+            }
+            m_open = false;
+            hide();
+            emit exitRequested();
+            return;
+        }
+        if (!down && was_down && !m_select_long_fired &&
+            now - m_select_pressed_at < kLongPressMs) {
+            if (m_open) {
+                if (m_layout_editor) {
+                    m_layout_editor = false;
+                    emit customLayoutChanged(true);
+                }
+                RequestResume(Button::Select);
+            } else {
+                OpenMenu();
+            }
+        }
+        return;
+    }
+
+    if (!m_open || m_resume_pending) {
+        return;
+    }
+
+    if (down && !was_down) {
+        m_button_pressed_at[index] = now;
+        m_button_last_repeat[index] = now;
+    }
+
+    const bool rising = down && !was_down;
+    const bool repeat = down && was_down && now - m_button_pressed_at[index] >= kRepeatDelayMs &&
+                        now - m_button_last_repeat[index] >= kRepeatIntervalMs;
+    if (repeat) {
+        m_button_last_repeat[index] = now;
+    }
+
+    if (m_layout_editor) {
+        HandleLayoutInput(button, rising, repeat);
+        return;
+    }
+
+    switch (button) {
+    case Button::Up:
+        if (rising || repeat) {
+            MoveSelection(-1);
+        }
+        break;
+    case Button::Down:
+        if (rising || repeat) {
+            MoveSelection(1);
+        }
+        break;
+    case Button::Left:
+        if (rising || repeat) {
+            ChangeChoice(-1);
+        }
+        break;
+    case Button::Right:
+        if (rising || repeat) {
+            ChangeChoice(1);
+        }
+        break;
+    case Button::A:
+        if (rising) {
+            ActivateSelected();
+        }
+        break;
+    case Button::B:
+        if (rising) {
+            GoBack();
+        }
+        break;
+    case Button::X:
+        if (rising) {
+            SwitchPage(-1);
+        }
+        break;
+    case Button::Y:
+        if (rising) {
+            SwitchPage(1);
+        }
+        break;
+    case Button::L1:
+        if (rising) {
+            SwitchPage(-1);
+        }
+        break;
+    case Button::R1:
+        if (rising) {
+            SwitchPage(1);
+        }
+        break;
+    case Button::Start:
+        if (rising) {
+            RequestResume(Button::Start);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void OsdOverlay::OpenMenu() {
+    if (m_shutdown || !parentWidget() || !parentWidget()->isVisible()) {
+        return;
+    }
+    m_open = true;
+    m_resume_pending = false;
+    m_layout_editor = false;
+    m_current_page = kMainPage;
+    m_previous_page = kMainPage;
+    m_selected = 0;
+    m_scroll = 0;
+    m_banner.clear();
+    BuildPages();
+    LOG_INFO(Frontend, "OSD opened");
+    show();
+    raise();
+    repaint();
+    emit pauseRequested();
+}
+
+void OsdOverlay::RequestResume(Button button) {
+    if (!m_open || m_resume_pending) {
+        return;
+    }
+    m_resume_pending = true;
+    m_resume_button = button;
+    ShowMessage(QStringLiteral("松开按键以继续"));
+    repaint();
+}
+
+void OsdOverlay::FinishResume() {
+    if (!m_resume_pending) {
+        return;
+    }
+    m_resume_pending = false;
+    m_open = false;
+    LOG_INFO(Frontend, "OSD resumed");
+    hide();
+    emit resumeRequested();
+}
+
+void OsdOverlay::MoveSelection(int delta) {
+    auto& rows = m_pages[m_current_page].rows;
+    if (rows.empty()) {
+        return;
+    }
+    m_selected = (m_selected + delta + static_cast<int>(rows.size())) % rows.size();
+    const int row_height = std::max(28, ListRect().height() / 10);
+    const int visible_rows = std::max(1, ListRect().height() / row_height);
+    if (m_selected < m_scroll) {
+        m_scroll = m_selected;
+    } else if (m_selected >= m_scroll + visible_rows) {
+        m_scroll = m_selected - visible_rows + 1;
+    }
+    repaint();
+}
+
+void OsdOverlay::ChangeChoice(int delta) {
+    Row& row = m_pages[m_current_page].rows[m_selected];
+    if (row.kind == RowKind::Choice && !row.choices.isEmpty()) {
+        row.selected = (row.selected + delta + row.choices.size()) % row.choices.size();
+        row.change(row.selected);
+        repaint();
+    } else if (row.kind != RowKind::Choice) {
+        SwitchPage(delta);
+    }
+}
+
+void OsdOverlay::ActivateSelected() {
+    Row& row = m_pages[m_current_page].rows[m_selected];
+    switch (row.kind) {
+    case RowKind::Action:
+        row.activate();
+        break;
+    case RowKind::Choice:
+        ChangeChoice(1);
+        break;
+    case RowKind::Page:
+        OpenPage(row.page);
+        break;
+    case RowKind::Info:
+        break;
+    }
+    repaint();
+}
+
+void OsdOverlay::OpenPage(int page) {
+    if (page < 0 || page >= static_cast<int>(m_pages.size()) || page == m_current_page) {
+        return;
+    }
+    m_previous_page = m_current_page;
+    m_previous_selection = m_selected;
+    m_current_page = page;
+    m_selected = page == kExitConfirmPage || page == kRestartConfirmPage ? 1 : 0;
+    m_scroll = 0;
+    repaint();
+}
+
+void OsdOverlay::GoBack() {
+    if (m_current_page == kMainPage) {
+        RequestResume(Button::B);
+        return;
+    }
+    m_current_page = m_previous_page;
+    m_selected = m_previous_selection;
+    m_scroll = 0;
+    repaint();
+}
+
+void OsdOverlay::SwitchPage(int delta) {
+    if (m_current_page > kControlsPage) {
+        return;
+    }
+    int page = (m_current_page + delta + kControlsPage + 1) % (kControlsPage + 1);
+    if (page == m_current_page) {
+        return;
+    }
+    m_previous_page = kMainPage;
+    m_previous_selection = 0;
+    m_current_page = page;
+    m_selected = 0;
+    m_scroll = 0;
+    repaint();
+}
+
+void OsdOverlay::ReadBattery() {
+    const qint64 now = NowMs();
+    if (now - m_last_battery_read < 5000) {
+        return;
+    }
+    m_last_battery_read = now;
+    for (const QString& path : {QStringLiteral("/sys/class/power_supply/battery/capacity"),
+                                QStringLiteral("/sys/class/power_supply/bms/capacity")}) {
+        QFile file(path);
+        if (file.open(QIODevice::ReadOnly)) {
+            bool ok = false;
+            const int value = file.readAll().trimmed().toInt(&ok);
+            if (ok) {
+                m_battery = std::clamp(value, 0, 100);
+                return;
+            }
+        }
+    }
+    m_battery = -1;
+}
+
+QRect OsdOverlay::PanelRect() const {
+    const int panel_width = std::min(900, std::max(320, width() - 48));
+    const int panel_height = std::min(650, std::max(300, height() - 48));
+    return QRect((width() - panel_width) / 2, (height() - panel_height) / 2, panel_width,
+                 panel_height);
+}
+
+QRect OsdOverlay::ListRect() const {
+    const QRect panel = PanelRect();
+    const qreal scale = std::clamp(std::min(width() / 1024.0, height() / 768.0), 0.75, 1.35);
+    return QRect(panel.left() + static_cast<int>(24 * scale),
+                 panel.top() + static_cast<int>(126 * scale),
+                 panel.width() - static_cast<int>(48 * scale),
+                 panel.height() - static_cast<int>(202 * scale));
+}
+
+OsdOverlay::LayoutRect OsdOverlay::GetLayoutRect(bool top) const {
+    const auto& s = Settings::values;
+    if (top) {
+        return {s.custom_top_x.GetValue(), s.custom_top_y.GetValue(),
+                s.custom_top_width.GetValue(), s.custom_top_height.GetValue()};
+    }
+    return {s.custom_bottom_x.GetValue(), s.custom_bottom_y.GetValue(),
+            s.custom_bottom_width.GetValue(), s.custom_bottom_height.GetValue()};
+}
+
+void OsdOverlay::SetLayoutRect(bool top, const LayoutRect& rect) {
+    auto& s = Settings::values;
+    if (top) {
+        s.custom_top_x = static_cast<u16>(rect.x);
+        s.custom_top_y = static_cast<u16>(rect.y);
+        s.custom_top_width = static_cast<u16>(rect.w);
+        s.custom_top_height = static_cast<u16>(rect.h);
+    } else {
+        s.custom_bottom_x = static_cast<u16>(rect.x);
+        s.custom_bottom_y = static_cast<u16>(rect.y);
+        s.custom_bottom_width = static_cast<u16>(rect.w);
+        s.custom_bottom_height = static_cast<u16>(rect.h);
+    }
+    ApplyLayoutChange(false);
+}
+
+void OsdOverlay::ApplyLayoutChange(bool commit) {
+    repaint();
+    emit customLayoutChanged(commit);
+}
+
+void OsdOverlay::OpenLayoutEditor() {
+    m_layout_editor = true;
+    m_layout_top = true;
+    m_layout_return_selection = m_selected;
+    m_layout_stick_last = NowMs() - kLayoutStickIntervalMs;
+    Assign(Settings::values.layout_option, Settings::LayoutOption::CustomLayout);
+    BuildPages();
+    emit settingsChanged();
+    ShowMessage(QStringLiteral("正在编辑上屏"));
+}
+
+void OsdOverlay::CloseLayoutEditor() {
+    if (!m_layout_editor) {
+        return;
+    }
+    m_layout_editor = false;
+    emit customLayoutChanged(true);
+    m_current_page = kVideoPage;
+    const int row_count = static_cast<int>(m_pages[kVideoPage].rows.size());
+    m_selected = std::clamp(m_layout_return_selection, 0, std::max(0, row_count - 1));
+    m_scroll = 0;
+    ShowMessage(QStringLiteral("布局已保存"));
+}
+
+void OsdOverlay::NudgeLayout(int dx, int dy) {
+    LayoutRect rect = GetLayoutRect(m_layout_top);
+    const int max_x = std::max(0, kLayoutMaxExtent - rect.w);
+    const int max_y = std::max(0, kLayoutMaxExtent - rect.h);
+    rect.x = std::clamp(rect.x + dx, 0, max_x);
+    rect.y = std::clamp(rect.y + dy, 0, max_y);
+    SetLayoutRect(m_layout_top, rect);
+}
+
+void OsdOverlay::ResizeLayout(int dw, int dh) {
+    LayoutRect rect = GetLayoutRect(m_layout_top);
+    rect.x = std::clamp(rect.x, 0, kLayoutMaxExtent - kLayoutMinWidth);
+    rect.y = std::clamp(rect.y, 0, kLayoutMaxExtent - kLayoutMinHeight);
+    rect.w = std::clamp(rect.w + dw, kLayoutMinWidth, kLayoutMaxExtent - rect.x);
+    rect.h = std::clamp(rect.h + dh, kLayoutMinHeight, kLayoutMaxExtent - rect.y);
+    SetLayoutRect(m_layout_top, rect);
+}
+
+void OsdOverlay::ResetLayout() {
+    auto& s = Settings::values;
+    s.custom_top_x = 0;
+    s.custom_top_y = 0;
+    s.custom_top_width = 800;
+    s.custom_top_height = 480;
+    s.custom_bottom_x = 240;
+    s.custom_bottom_y = 480;
+    s.custom_bottom_width = 320;
+    s.custom_bottom_height = 240;
+    ApplyLayoutChange(false);
+    ShowMessage(QStringLiteral("布局已恢复默认"));
+}
+
+void OsdOverlay::HandleLayoutInput(Button button, bool rising, bool repeat) {
+    switch (button) {
+    case Button::Up:
+        if (rising || repeat) {
+            NudgeLayout(0, -kLayoutStep);
+        }
+        break;
+    case Button::Down:
+        if (rising || repeat) {
+            NudgeLayout(0, kLayoutStep);
+        }
+        break;
+    case Button::Left:
+        if (rising || repeat) {
+            NudgeLayout(-kLayoutStep, 0);
+        }
+        break;
+    case Button::Right:
+        if (rising || repeat) {
+            NudgeLayout(kLayoutStep, 0);
+        }
+        break;
+    case Button::X:
+        if (rising || repeat) {
+            ResizeLayout(0, -kLayoutStep);
+        }
+        break;
+    case Button::Y:
+        if (rising || repeat) {
+            ResizeLayout(0, kLayoutStep);
+        }
+        break;
+    case Button::L1:
+        if (rising || repeat) {
+            ResizeLayout(-kLayoutStep, 0);
+        }
+        break;
+    case Button::R1:
+        if (rising || repeat) {
+            ResizeLayout(kLayoutStep, 0);
+        }
+        break;
+    case Button::A:
+        if (rising) {
+            m_layout_top = !m_layout_top;
+            ShowMessage(QStringLiteral("正在编辑%1")
+                            .arg(m_layout_top ? QStringLiteral("上屏") : QStringLiteral("下屏")));
+        }
+        break;
+    case Button::B:
+        if (rising) {
+            CloseLayoutEditor();
+        }
+        break;
+    case Button::Start:
+        if (rising) {
+            ResetLayout();
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void OsdOverlay::HandleLayoutStick(float x, float y) {
+    int dx = 0;
+    int dy = 0;
+    if (x < -0.55f) {
+        dx = -kLayoutStep;
+    } else if (x > 0.55f) {
+        dx = kLayoutStep;
+    }
+    if (y > 0.55f) {
+        dy = -kLayoutStep;
+    } else if (y < -0.55f) {
+        dy = kLayoutStep;
+    }
+    if (dx == 0 && dy == 0) {
+        return;
+    }
+    const qint64 now = NowMs();
+    if (now - m_layout_stick_last < kLayoutStickIntervalMs) {
+        return;
+    }
+    NudgeLayout(dx, dy);
+    m_layout_stick_last = now;
+}
+
+void OsdOverlay::PaintLayoutEditor(QPainter& painter) {
+    const qreal scale = std::clamp(std::min(width() / 1024.0, height() / 768.0), 0.75, 1.35);
+    const int margin = static_cast<int>(24 * scale);
+    const QColor top_color(86, 180, 255);
+    const QColor bottom_color(255, 176, 72);
+    const QColor active_color = m_layout_top ? top_color : bottom_color;
+
+    painter.fillRect(rect(), QColor(6, 10, 16, 244));
+
+    QFont title_font = QApplication::font();
+    title_font.setPixelSize(static_cast<int>(28 * scale));
+    title_font.setBold(true);
+    painter.setFont(title_font);
+    painter.setPen(QColor(245, 248, 252));
+    painter.drawText(margin, static_cast<int>(42 * scale), QStringLiteral("自定义布局"));
+
+    ReadBattery();
+    QFont small_font = QApplication::font();
+    small_font.setPixelSize(static_cast<int>(15 * scale));
+    painter.setFont(small_font);
+    QString status = QTime::currentTime().toString(QStringLiteral("HH:mm"));
+    if (m_battery >= 0) {
+        status += QStringLiteral("  %1%").arg(m_battery);
+    }
+    painter.setPen(QColor(190, 207, 220));
+    painter.drawText(width() - margin - painter.fontMetrics().horizontalAdvance(status),
+                     static_cast<int>(42 * scale), status);
+
+    const QString edit_text =
+        QStringLiteral("正在编辑%1")
+            .arg(m_layout_top ? QStringLiteral("上屏") : QStringLiteral("下屏"));
+    painter.setPen(active_color);
+    painter.drawText(margin, static_cast<int>(68 * scale), edit_text);
+    painter.setPen(QColor(151, 165, 184));
+    const int edit_width = painter.fontMetrics().horizontalAdvance(edit_text);
+    const QString game_title = painter.fontMetrics().elidedText(
+        m_game_title, Qt::ElideRight, width() - margin * 2 - edit_width - static_cast<int>(20 * scale));
+    painter.drawText(margin + edit_width + static_cast<int>(10 * scale),
+                     static_cast<int>(68 * scale), game_title);
+
+    const int header_bottom = static_cast<int>(88 * scale);
+    const int footer_top = height() - static_cast<int>(128 * scale);
+    const QRect avail(margin, header_bottom, width() - margin * 2,
+                      std::max(80, footer_top - header_bottom));
+    int display_width = avail.width();
+    int display_height = static_cast<int>(display_width * 3.0 / 4.0);
+    if (display_height > avail.height()) {
+        display_height = avail.height();
+        display_width = static_cast<int>(display_height * 4.0 / 3.0);
+    }
+    const QRect display(avail.center().x() - display_width / 2,
+                        avail.top() + (avail.height() - display_height) / 2, display_width,
+                        display_height);
+    painter.fillRect(display, QColor(2, 4, 7));
+    painter.setPen(QPen(QColor(66, 82, 101), 1.5));
+    painter.drawRect(display.adjusted(0, 0, -1, -1));
+
+    const LayoutRect top = GetLayoutRect(true);
+    const LayoutRect bottom = GetLayoutRect(false);
+    const int canvas_w = std::max({1, top.x + top.w, bottom.x + bottom.w});
+    const int canvas_h = std::max({1, top.y + top.h, bottom.y + bottom.h});
+    const qreal fit = std::min(static_cast<double>(display.width()) / canvas_w,
+                               static_cast<double>(display.height()) / canvas_h);
+    const int draw_width = std::max(1, static_cast<int>(std::lround(canvas_w * fit)));
+    const int draw_height = std::max(1, static_cast<int>(std::lround(canvas_h * fit)));
+    const QRect canvas(display.center().x() - draw_width / 2,
+                       display.center().y() - draw_height / 2, draw_width, draw_height);
+    painter.fillRect(canvas, QColor(11, 16, 24));
+    painter.setPen(QPen(QColor(54, 70, 90), 1.0));
+    painter.drawRect(canvas.adjusted(0, 0, -1, -1));
+
+    painter.setPen(QPen(QColor(50, 64, 82, 90), 1.0));
+    for (int gx = 100; gx < canvas_w; gx += 100) {
+        const int x = canvas.left() + static_cast<int>(std::lround(gx * fit));
+        painter.drawLine(x, canvas.top(), x, canvas.bottom());
+    }
+    for (int gy = 100; gy < canvas_h; gy += 100) {
+        const int y = canvas.top() + static_cast<int>(std::lround(gy * fit));
+        painter.drawLine(canvas.left(), y, canvas.right(), y);
+    }
+
+    const auto slot_rect = [&](const LayoutRect& r) {
+        return QRect(canvas.left() + static_cast<int>(std::lround(r.x * fit)),
+                     canvas.top() + static_cast<int>(std::lround(r.y * fit)),
+                     std::max(1, static_cast<int>(std::lround(r.w * fit))),
+                     std::max(1, static_cast<int>(std::lround(r.h * fit))));
+    };
+    const auto draw_slot = [&](const LayoutRect& r, bool is_top) {
+        const bool active = is_top == m_layout_top;
+        const QColor base = is_top ? top_color : bottom_color;
+        const QRect rr = slot_rect(r);
+        QColor fill = base;
+        fill.setAlpha(active ? 105 : 65);
+        painter.fillRect(rr, fill);
+        painter.setPen(QPen(base, active ? 3.0 : 1.5));
+        painter.drawRect(rr.adjusted(0, 0, -1, -1));
+        if (rr.width() < static_cast<int>(52 * scale) ||
+            rr.height() < static_cast<int>(24 * scale)) {
+            return;
+        }
+        QFont label_font = small_font;
+        label_font.setPixelSize(static_cast<int>(16 * scale));
+        label_font.setBold(true);
+        painter.setFont(label_font);
+        painter.setPen(QColor(255, 255, 255, active ? 255 : 210));
+        painter.drawText(rr.adjusted(6, 4, -6, -4), Qt::AlignLeft | Qt::AlignTop,
+                         is_top ? QStringLiteral("上屏") : QStringLiteral("下屏"));
+        if (rr.height() >= static_cast<int>(58 * scale)) {
+            QFont size_font = small_font;
+            size_font.setPixelSize(static_cast<int>(13 * scale));
+            painter.setFont(size_font);
+            painter.setPen(QColor(235, 242, 250, active ? 230 : 180));
+            painter.drawText(rr.adjusted(6, 4, -6, -4), Qt::AlignLeft | Qt::AlignBottom,
+                             QStringLiteral("%1 x %2").arg(r.w).arg(r.h));
+        }
+    };
+    draw_slot(top, true);
+    draw_slot(bottom, false);
+
+    painter.setPen(QPen(QColor(54, 70, 90), 1.0));
+    painter.drawLine(margin, footer_top, width() - margin, footer_top);
+
+    QFont info_font = small_font;
+    info_font.setPixelSize(static_cast<int>(18 * scale));
+    painter.setFont(info_font);
+    const auto draw_readout = [&](bool is_top, int y) {
+        const LayoutRect r = is_top ? top : bottom;
+        const bool active = is_top == m_layout_top;
+        const QColor base = is_top ? top_color : bottom_color;
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(base);
+        painter.drawEllipse(QPoint(margin + static_cast<int>(5 * scale), y - static_cast<int>(6 * scale)),
+                            static_cast<int>(5 * scale), static_cast<int>(5 * scale));
+        QFont font = info_font;
+        font.setBold(active);
+        painter.setFont(font);
+        painter.setPen(active ? base : QColor(150, 164, 182));
+        painter.drawText(margin + static_cast<int>(18 * scale), y,
+                         is_top ? QStringLiteral("上屏") : QStringLiteral("下屏"));
+        painter.setPen(active ? QColor(240, 246, 252) : QColor(168, 181, 197));
+        painter.drawText(margin + static_cast<int>(92 * scale), y,
+                         QStringLiteral("X %1    Y %2    宽 %3    高 %4")
+                             .arg(r.x)
+                             .arg(r.y)
+                             .arg(r.w)
+                             .arg(r.h));
+    };
+    const int info_y = footer_top + static_cast<int>(26 * scale);
+    draw_readout(true, info_y);
+    draw_readout(false, info_y + static_cast<int>(26 * scale));
+    painter.setFont(small_font);
+    painter.setPen(QColor(132, 148, 167));
+    const double window_fit = std::min(static_cast<double>(width()) / canvas_w,
+                                       static_cast<double>(height()) / canvas_h);
+    const QString canvas_text = QStringLiteral("画布 %1 x %2    缩放 %3%")
+                                    .arg(canvas_w)
+                                    .arg(canvas_h)
+                                    .arg(std::lround(window_fit * 100));
+    painter.drawText(width() - margin - painter.fontMetrics().horizontalAdvance(canvas_text), info_y,
+                     canvas_text);
+    if (Settings::values.swap_screen.GetValue()) {
+        const QString swap_text = QStringLiteral("已开启交换屏幕");
+        painter.setPen(bottom_color);
+        painter.drawText(width() - margin - painter.fontMetrics().horizontalAdvance(swap_text),
+                         info_y + static_cast<int>(26 * scale), swap_text);
+    }
+
+    const QString hint_move = QStringLiteral(
+        "方向键 / 摇杆：移动    L1 / R1：宽度    X / Y：高度    A：切换屏幕");
+    const QString hint_actions =
+        QStringLiteral("B：保存退出    Start：重置    Select：保存并继续    长按 Select：退出");
+    painter.setPen(QColor(145, 159, 178));
+    painter.drawText(margin, footer_top + static_cast<int>(78 * scale),
+                     painter.fontMetrics().elidedText(hint_move, Qt::ElideRight, width() - margin * 2));
+    painter.setPen(m_banner.isEmpty() ? QColor(145, 159, 178) : QColor(100, 222, 241));
+    const QString hint_text = m_banner.isEmpty() ? hint_actions : m_banner;
+    painter.drawText(margin, footer_top + static_cast<int>(102 * scale),
+                     painter.fontMetrics().elidedText(hint_text, Qt::ElideRight, width() - margin * 2));
+}
+
+void OsdOverlay::paintEvent(QPaintEvent*) {
+    QPainter painter(this);
+    painter.setRenderHint(QPainter::Antialiasing);
+    if (m_layout_editor) {
+        PaintLayoutEditor(painter);
+        return;
+    }
+    painter.fillRect(rect(), QColor(0, 0, 0, 155));
+
+    const qreal scale = std::clamp(std::min(width() / 1024.0, height() / 768.0), 0.75, 1.35);
+    const QRect panel = PanelRect();
+    QPainterPath panel_path;
+    panel_path.addRoundedRect(panel, static_cast<int>(18 * scale), static_cast<int>(18 * scale));
+    painter.fillPath(panel_path, QColor(13, 18, 27, 246));
+    painter.setPen(QPen(QColor(72, 205, 231, 220), static_cast<qreal>(2 * scale)));
+    painter.drawPath(panel_path);
+
+    QFont title_font = QApplication::font();
+    title_font.setPixelSize(static_cast<int>(29 * scale));
+    title_font.setBold(true);
+    painter.setFont(title_font);
+    painter.setPen(QColor(245, 248, 252));
+    painter.drawText(panel.left() + static_cast<int>(28 * scale),
+                     panel.top() + static_cast<int>(43 * scale), m_pages[m_current_page].title);
+
+    QFont small_font = QApplication::font();
+    small_font.setPixelSize(static_cast<int>(15 * scale));
+    painter.setFont(small_font);
+    painter.setPen(QColor(151, 165, 184));
+    const QString subtitle = m_game_title.left(70);
+    painter.drawText(panel.left() + static_cast<int>(29 * scale),
+                     panel.top() + static_cast<int>(65 * scale),
+                     painter.fontMetrics().elidedText(subtitle, Qt::ElideRight,
+                                                      panel.width() / 2));
+
+    ReadBattery();
+    QString status = QTime::currentTime().toString(QStringLiteral("HH:mm"));
+    if (m_battery >= 0) {
+        status += QStringLiteral("  %1%").arg(m_battery);
+    }
+    painter.setPen(QColor(190, 207, 220));
+    painter.drawText(panel.right() - static_cast<int>(28 * scale) -
+                         painter.fontMetrics().horizontalAdvance(status),
+                     panel.top() + static_cast<int>(43 * scale), status);
+
+    const QStringList tabs{QStringLiteral("主菜单"), QStringLiteral("视频"), QStringLiteral("音频"),
+                           QStringLiteral("系统"), QStringLiteral("操作说明")};
+    const int tabs_left = panel.left() + static_cast<int>(24 * scale);
+    const int tabs_top = panel.top() + static_cast<int>(80 * scale);
+    const int tab_width = (panel.width() - static_cast<int>(48 * scale)) / tabs.size();
+    QFont tab_font = small_font;
+    tab_font.setPixelSize(static_cast<int>(17 * scale));
+    tab_font.setBold(true);
+    painter.setFont(tab_font);
+    for (int i = 0; i < tabs.size(); ++i) {
+        const QRect tab(tabs_left + i * tab_width, tabs_top, tab_width - 4,
+                        static_cast<int>(38 * scale));
+        if (i == m_current_page) {
+            painter.fillRect(tab, QColor(43, 182, 207, 42));
+            painter.setPen(QColor(80, 220, 242));
+            painter.drawLine(tab.left(), tab.bottom(), tab.right(), tab.bottom());
+        } else {
+            painter.setPen(QColor(127, 143, 163));
+        }
+        painter.drawText(tab, Qt::AlignHCenter | Qt::AlignVCenter, tabs[i]);
+    }
+
+    const QRect list = ListRect();
+    const int row_height = static_cast<int>(45 * scale);
+    const int visible_rows = std::max(1, list.height() / row_height);
+    const auto& rows = m_pages[m_current_page].rows;
+    m_scroll = std::clamp(m_scroll, 0, std::max(0, static_cast<int>(rows.size()) - visible_rows));
+
+    QFont row_font = QApplication::font();
+    row_font.setPixelSize(static_cast<int>(20 * scale));
+    painter.setFont(row_font);
+    for (int visible = 0; visible < visible_rows; ++visible) {
+        const int index = m_scroll + visible;
+        if (index >= static_cast<int>(rows.size())) {
+            break;
+        }
+        const Row& row = rows[index];
+        const QRect row_rect(list.left(), list.top() + visible * row_height, list.width(), row_height - 3);
+        const bool selected = index == m_selected;
+        if (selected) {
+            QPainterPath selection_path;
+            selection_path.addRoundedRect(row_rect, static_cast<int>(8 * scale),
+                                          static_cast<int>(8 * scale));
+            painter.fillPath(selection_path, QColor(38, 185, 211, 48));
+            painter.setPen(QPen(QColor(70, 214, 237, 190), static_cast<qreal>(1.5 * scale)));
+            painter.drawPath(selection_path);
+            painter.fillRect(row_rect.left(), row_rect.top() + static_cast<int>(7 * scale),
+                             static_cast<int>(4 * scale), row_rect.height() - static_cast<int>(14 * scale),
+                             QColor(75, 221, 242));
+        }
+
+        QColor text_color = row.kind == RowKind::Info ? QColor(151, 165, 184) : QColor(231, 237, 245);
+        if (selected) {
+            text_color = QColor(255, 255, 255);
+        }
+        painter.setPen(text_color);
+        QString value;
+        if (row.kind == RowKind::Choice && !row.choices.isEmpty()) {
+            value = row.choices[row.selected];
+        } else if (row.kind == RowKind::Page) {
+            value = QStringLiteral(">");
+        }
+        const int value_width = value.isEmpty() ? 0 : painter.fontMetrics().horizontalAdvance(value) +
+                                                       static_cast<int>(18 * scale);
+        const QString label = painter.fontMetrics().elidedText(
+            row.label, Qt::ElideRight, row_rect.width() - static_cast<int>(36 * scale) - value_width);
+        painter.drawText(row_rect.left() + static_cast<int>(18 * scale), row_rect.center().y() +
+                         painter.fontMetrics().ascent() / 2 - painter.fontMetrics().descent(), label);
+        if (!value.isEmpty()) {
+            painter.setPen(selected ? QColor(100, 231, 250) : QColor(103, 205, 224));
+            painter.drawText(row_rect.right() - static_cast<int>(16 * scale) -
+                                 painter.fontMetrics().horizontalAdvance(value),
+                             row_rect.center().y() + painter.fontMetrics().ascent() / 2 -
+                                 painter.fontMetrics().descent(),
+                             value);
+        }
+    }
+
+    const QRect footer = panel.adjusted(static_cast<int>(24 * scale), 0,
+                                        -static_cast<int>(24 * scale), -static_cast<int>(14 * scale));
+    painter.setFont(small_font);
+    QString hint = m_banner;
+    if (hint.isEmpty() && m_selected < static_cast<int>(rows.size())) {
+        hint = rows[m_selected].hint;
+    }
+    painter.setPen(hint.isEmpty() ? QColor(132, 148, 167) : QColor(100, 222, 241));
+    const QString hint_text = painter.fontMetrics().elidedText(hint, Qt::ElideRight, footer.width());
+    painter.drawText(footer.left(), panel.bottom() - static_cast<int>(53 * scale), hint_text);
+    painter.setPen(QColor(145, 159, 178));
+    const QString controls = QStringLiteral(
+        "方向键 / 摇杆：导航    L1 / R1：翻页    左 / 右：调整    A：确认    B：返回    "
+        "Select：菜单");
+    painter.drawText(footer.left(), panel.bottom() - static_cast<int>(29 * scale),
+                     painter.fontMetrics().elidedText(controls, Qt::ElideRight, footer.width()));
+}
+
+bool OsdOverlay::eventFilter(QObject* watched, QEvent* event) {
+    if (watched == parentWidget() && event->type() == QEvent::Resize) {
+        setGeometry(parentWidget()->rect());
+        if (m_open) {
+            raise();
+        }
+    }
+    return QWidget::eventFilter(watched, event);
+}
