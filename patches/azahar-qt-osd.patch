+              Settings::values.enable_realtime_audio);
+
+    Page& system = m_pages[kSystemPage];
+    AddToggle(system, QStringLiteral("New 3DS Mode"),
+              QStringLiteral("Use New 3DS CPU and memory limits"), Settings::values.is_new_3ds);
+    AddChoice(system, QStringLiteral("CPU Clock"), QStringLiteral("Emulated CPU clock percentage"),
+              Settings::values.cpu_clock_percentage,
+              {{QStringLiteral("50%"), 50},
+               {QStringLiteral("75%"), 75},
+               {QStringLiteral("100%"), 100},
+               {QStringLiteral("150%"), 150},
+               {QStringLiteral("200%"), 200},
+               {QStringLiteral("300%"), 300},
+               {QStringLiteral("400%"), 400}});
+    AddChoice(system, QStringLiteral("Region"), QStringLiteral("Console region"),
+              Settings::values.region_value,
+              {{QStringLiteral("Auto"), Settings::REGION_VALUE_AUTO_SELECT},
+               {QStringLiteral("Japan"), 0},
+               {QStringLiteral("USA"), 1},
+               {QStringLiteral("Europe"), 2},
+               {QStringLiteral("Australia"), 3},
+               {QStringLiteral("China"), 4},
+               {QStringLiteral("Korea"), 5}});
+    AddInfo(system, QStringLiteral("Some system settings apply on the next game launch."));
+
+    Page& controls = m_pages[kControlsPage];
+    AddInfo(controls, QStringLiteral("Navigate: D-pad or left stick"));
+    AddInfo(controls, QStringLiteral("Select / activate: A"));
+    AddInfo(controls, QStringLiteral("Back / resume: B"));
+    AddInfo(controls, QStringLiteral("Adjust value: Left / Right"));
+    AddInfo(controls, QStringLiteral("Change tab: X / Y"));
+    AddInfo(controls, QStringLiteral("Open menu: short Select"));
+    AddInfo(controls, QStringLiteral("Close menu: short Select"));
+    AddInfo(controls, QStringLiteral("Exit game: hold Select"));
+
+    Page& exit_confirm = m_pages[kExitConfirmPage];
+    AddInfo(exit_confirm, QStringLiteral("Unsaved progress will be lost."));
+    AddAction(exit_confirm, QStringLiteral("Yes, Exit Game"), QStringLiteral("Return to the game list"),
+              [this] {
+                  hide();
+                  m_open = false;
+                  emit exitRequested();
+              });
+    AddAction(exit_confirm, QStringLiteral("Cancel"), QStringLiteral("Return to the menu"),
+              [this] { GoBack(); });
+
+    Page& restart_confirm = m_pages[kRestartConfirmPage];
+    AddInfo(restart_confirm, QStringLiteral("The game will start again from its title screen."));
+    AddAction(restart_confirm, QStringLiteral("Yes, Restart Game"), QStringLiteral("Restart now"),
+              [this] {
+                  hide();
+                  m_open = false;
+                  emit restartRequested();
+              });
+    AddAction(restart_confirm, QStringLiteral("Cancel"), QStringLiteral("Return to the menu"),
+              [this] { GoBack(); });
+
+    m_current_page = std::clamp(m_current_page, 0, static_cast<int>(m_pages.size()) - 1);
+    m_selected = std::clamp(m_selected, 0, static_cast<int>(m_pages[m_current_page].rows.size()) - 1);
+    m_scroll = 0;
+}
