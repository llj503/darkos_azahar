+QStringList OsdOverlay::AvailableBackgroundImages() {
+    QDir dir(BackgroundDirectory());
+    if (!dir.exists()) {
+        dir.mkpath(QStringLiteral("."));
+    }
+    const QStringList filters{QStringLiteral("*.png"), QStringLiteral("*.jpg"),
+                              QStringLiteral("*.jpeg"), QStringLiteral("*.webp"),
+                              QStringLiteral("*.bmp")};
+    QStringList images;
+    for (const QFileInfo& entry : dir.entryInfoList(filters, QDir::Files, QDir::Name)) {
+        images.append(entry.absoluteFilePath());
+    }
+    return images;
+}
