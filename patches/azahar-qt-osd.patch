+void OsdOverlay::BuildPages() {
+    m_pages.clear();
+    m_pages.resize(7);
+    m_pages[kMainPage].title = QStringLiteral("Azahar Nano");
+    m_pages[kVideoPage].title = QStringLiteral("Video");
+    m_pages[kAudioPage].title = QStringLiteral("Audio");
+    m_pages[kSystemPage].title = QStringLiteral("System");
+    m_pages[kControlsPage].title = QStringLiteral("Controls");
+    m_pages[kExitConfirmPage].title = QStringLiteral("Exit Game");
+    m_pages[kRestartConfirmPage].title = QStringLiteral("Restart Game");
+
+    Page& main = m_pages[kMainPage];
+    AddAction(main, QStringLiteral("Resume"), QStringLiteral("Return to the game"), [this] {
+        RequestResume(Button::A);
+    });
+    AddAction(main, QStringLiteral("Save State"), QStringLiteral("Save to the selected slot"),
+              [this] { emit saveStateRequested(m_slot); });
+    AddAction(main, QStringLiteral("Load State"), QStringLiteral("Load the selected slot"),
+              [this] { emit loadStateRequested(m_slot); });
+    AddChoice(main, QStringLiteral("State Slot"), QStringLiteral("Savestate slot"),
+              QStringList{QStringLiteral("1"), QStringLiteral("2"), QStringLiteral("3"),
+                          QStringLiteral("4"), QStringLiteral("5"), QStringLiteral("6"),
+                          QStringLiteral("7"), QStringLiteral("8"), QStringLiteral("9"),
+                          QStringLiteral("10")},
+              m_slot - 1, [this](int index) { m_slot = index + 1; });
+    AddPageRow(main, QStringLiteral("Video"),
+               QStringLiteral("Resolution, layout, frame rate and shaders"), kVideoPage);
+    AddPageRow(main, QStringLiteral("Audio"), QStringLiteral("Volume and audio timing"), kAudioPage);
+    AddPageRow(main, QStringLiteral("System"), QStringLiteral("Console mode, region and CPU clock"),
+               kSystemPage);
+    AddPageRow(main, QStringLiteral("Controls"), QStringLiteral("Controller button reference"),
+               kControlsPage);
+    AddAction(main,
+              m_per_game_active ? QStringLiteral("Delete Per-Game Override")
+                                : QStringLiteral("Create Per-Game Override"),
+              m_per_game_active ? QStringLiteral("Remove this game's separate settings")
+                                : QStringLiteral("Keep changes separate for this game"),
+              [this] { emit overrideToggleRequested(); });
+    AddPageRow(main, QStringLiteral("Restart Game"), QStringLiteral("Start this game again"),
+               kRestartConfirmPage);
+    AddPageRow(main, QStringLiteral("Exit Game"), QStringLiteral("Return to the game list"),
