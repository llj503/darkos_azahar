+class EvdevButtonDevice final : public Input::ButtonDevice {
+public:
+    EvdevButtonDevice(std::shared_ptr<EvdevGamepad> gamepad, size_t index)
+        : m_gamepad{std::move(gamepad)}, m_index{index} {}
+
+    bool GetStatus() const override {
+        return m_gamepad->GetButton(m_index);
+    }
+
+private:
+    std::shared_ptr<EvdevGamepad> m_gamepad;
+    size_t m_index;
+};
+
+class EvdevAnalogDevice final : public Input::AnalogDevice {
+public:
+    explicit EvdevAnalogDevice(std::shared_ptr<EvdevGamepad> gamepad)
+        : m_gamepad{std::move(gamepad)} {}
+
+    std::tuple<float, float> GetStatus() const override {
+        return m_gamepad->GetStick();
+    }
+
+private:
+    std::shared_ptr<EvdevGamepad> m_gamepad;
+};
