+QString OsdOverlay::LoadBackgroundImage() {
+    QSettings settings(BackgroundSettingsFile(), QSettings::IniFormat);
+    return settings.value(QStringLiteral("background/image")).toString();
+}
+
+void OsdOverlay::SaveBackgroundImage(const QString& path) {
+    QSettings settings(BackgroundSettingsFile(), QSettings::IniFormat);
+    if (path.isEmpty()) {
+        settings.remove(QStringLiteral("background/image"));
+    } else {
+        settings.setValue(QStringLiteral("background/image"), path);
+    }
+    settings.sync();
+}
