+OsdOverlay::OsdOverlay(QWidget* parent, const QString& game_title, bool per_game_active)
+    : QWidget(parent), m_per_game_active{per_game_active}, m_game_title{game_title} {
+    setObjectName(QStringLiteral("azaharOsdOverlay"));
+    setAttribute(Qt::WA_NoSystemBackground);
+    setAttribute(Qt::WA_TranslucentBackground);
+    setAttribute(Qt::WA_TransparentForMouseEvents);
+    setAttribute(Qt::WA_AlwaysStackOnTop);
+    setAttribute(Qt::WA_NativeWindow);
+    setAttribute(Qt::WA_DontCreateNativeAncestors);
+    setFocusPolicy(Qt::NoFocus);
+    hide();
+
+    BuildPages();
+    CreateInputDevices();
+
+    m_timer = new QTimer(this);
+    m_timer->setInterval(16);
+    connect(m_timer, &QTimer::timeout, this, &OsdOverlay::PollInput);
+    m_timer->start();
+
+    m_banner_timer = new QTimer(this);
+    m_banner_timer->setSingleShot(true);
+    connect(m_banner_timer, &QTimer::timeout, this, [this] {
+        m_banner.clear();
+        repaint();
+    });
+
+    if (parent) {
+        parent->installEventFilter(this);
+        setGeometry(parent->rect());
+    }
+}
+
+OsdOverlay::~OsdOverlay() {
+    Shutdown();
+}
+
+void OsdOverlay::Shutdown() {
+    if (m_shutdown) {
+        return;
+    }
+    m_shutdown = true;
+    if (m_timer) {
+        m_timer->stop();
+    }
+    if (m_banner_timer) {
+        m_banner_timer->stop();
+    }
+    hide();
+}
+
+void OsdOverlay::SetPerGameOverride(bool active) {
+    m_per_game_active = active;
+    BuildPages();
+    m_selected = std::clamp(m_selected, 0, static_cast<int>(m_pages[m_current_page].rows.size()) - 1);
+    ShowMessage(active ? QStringLiteral("Per-game override enabled")
+                       : QStringLiteral("Per-game override removed"));
+    repaint();
+}
+
+void OsdOverlay::PreparePerGameOverride() {
+    m_per_game_active = true;
+    Snapshot(Settings::values.resolution_factor);
+    Snapshot(Settings::values.layout_option);
+    Snapshot(Settings::values.swap_screen);
+    Snapshot(Settings::values.frame_limit);
+    Snapshot(Settings::values.use_disk_shader_cache);
+    Snapshot(Settings::values.volume);
+    Snapshot(Settings::values.enable_audio_stretching);
+    Snapshot(Settings::values.enable_realtime_audio);
+    Snapshot(Settings::values.is_new_3ds);
+    Snapshot(Settings::values.cpu_clock_percentage);
+    Snapshot(Settings::values.region_value);
+}
+
+void OsdOverlay::ShowMessage(const QString& message) {
+    m_banner = message;
+    if (m_banner_timer) {
+        m_banner_timer->start(1800);
+    }
+    repaint();
+}
