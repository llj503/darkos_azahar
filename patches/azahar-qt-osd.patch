+
+    Page& audio = m_pages[kAudioPage];
+    std::vector<std::pair<QString, float>> volume_choices;
+    for (int percent = 0; percent <= 100; percent += 10) {
+        volume_choices.emplace_back(QStringLiteral("%1%").arg(percent), percent / 100.0f);
