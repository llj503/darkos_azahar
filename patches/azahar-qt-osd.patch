+void RendererOpenGL::DrawBackground(const Layout::FramebufferLayout& layout,
+                                    bool stereo_single_screen) {
+    {
+        std::scoped_lock lock{background_image_mutex};
+        if (background_image_version != background_texture_version) {
+            background_texture_version = background_image_version;
+            if (!background_texture.handle) {
+                background_texture.Create();
+            }
+
+            background_texture_width = background_image.width;
+            background_texture_height = background_image.height;
+            if (background_image.rgba.empty() || background_texture_width == 0 ||
+                background_texture_height == 0) {
+                background_texture_width = 0;
+                background_texture_height = 0;
+            } else {
+                state.texture_units[0].texture_2d = background_texture.handle;
+                state.Apply();
+
+                glActiveTexture(GL_TEXTURE0);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+                glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, background_texture_width,
+                             background_texture_height, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+                             background_image.rgba.data());
+
+                state.texture_units[0].texture_2d = 0;
+                state.Apply();
+            }
+        }
+    }
+
+    if (background_texture_width == 0 || background_texture_height == 0 || layout.width == 0 ||
+        layout.height == 0) {
+        return;
+    }
+
+    // Fill the framebuffer and crop the image to the window aspect ratio.
+    const double dst_aspect = static_cast<double>(layout.width) / layout.height;
+    const double img_aspect =
+        static_cast<double>(background_texture_width) / background_texture_height;
+    float u0 = 0.0f;
+    float u1 = 1.0f;
+    float v0 = 0.0f;
+    float v1 = 1.0f;
+    if (img_aspect > dst_aspect) {
+        const auto margin = static_cast<float>((1.0 - dst_aspect / img_aspect) / 2.0);
+        u0 = margin;
+        u1 = 1.0f - margin;
+    } else {
+        const auto margin = static_cast<float>((1.0 - img_aspect / dst_aspect) / 2.0);
+        v0 = margin;
+        v1 = 1.0f - margin;
+    }
+
+    // QImage rows start at the top, which OpenGL stores at v=0.
+    const auto width = static_cast<float>(layout.width);
+    const auto height = static_cast<float>(layout.height);
+    const std::array<ScreenRectVertex, 4> vertices{{
+        ScreenRectVertex(0.0f, 0.0f, u0, v0),
+        ScreenRectVertex(width, 0.0f, u1, v0),
+        ScreenRectVertex(0.0f, height, u0, v1),
+        ScreenRectVertex(width, height, u1, v1),
+    }};
+
+    const GLuint sampler = samplers[1].handle;
+    glUniform4f(uniform_i_resolution, static_cast<float>(background_texture_width),
+                static_cast<float>(background_texture_height),
+                1.0f / static_cast<float>(background_texture_width),
+                1.0f / static_cast<float>(background_texture_height));
+    glUniform4f(uniform_o_resolution, height, width, 1.0f / height, 1.0f / width);
+    glUniform1i(uniform_layer, 0);
+    state.texture_units[0].texture_2d = background_texture.handle;
+    state.texture_units[0].sampler = sampler;
+    if (stereo_single_screen) {
+        state.texture_units[1].texture_2d = background_texture.handle;
+        state.texture_units[1].sampler = sampler;
+    }
+    state.Apply();
+
+    glBufferSubData(GL_ARRAY_BUFFER, 0, sizeof(vertices), vertices.data());
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+    state.texture_units[0].texture_2d = 0;
+    state.texture_units[0].sampler = 0;
+    if (stereo_single_screen) {
+        state.texture_units[1].texture_2d = 0;
+        state.texture_units[1].sampler = 0;
+    }
+    state.Apply();
+}
+
 void RendererOpenGL::ApplySecondLayerOpacity(float opacity) {
     state.blend.src_rgb_func = GL_CONSTANT_ALPHA;
     state.blend.src_a_func = GL_CONSTANT_ALPHA;
